{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp -C . build",
        "dev": "vp -C . dev",
        "test": "npm run test --workspaces --if-present && npm run test:client",
        "test:client": "vitest run --config vitest.config.ts",
        "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:client",
        "typecheck:client": "tsc --noEmit -p resources/js/game/tsconfig.json"
    },
    "dependencies": {
        "@colyseus/sdk": "^0.18.2",
        "@laravel/passkeys": "^0.2.0",
        "@tailwindcss/vite": "^4.1.11",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "phaser": "^4.2.1",
        "tailwindcss": "^4.0.7",
        "vite": "^8.0.0",
        "vite-plus": "0.3.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "devDependencies": {
        "typescript": "~5.9.0",
        "vitest": "^4.1.11"
    },
    "workspaces": [
        "shared",
        "game-server"
    ]
}
